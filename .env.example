# Backend Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
ENVIRONMENT=development
LOG_LEVEL=INFO

# Elexon BMRS API Config
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Day-ahead decision time in Europe/London (typically 12:00 / 17:00 / gate closure)
DEFAULT_DECISION_TIME_HHMM=12:00
DEFAULT_TIMEZONE=Europe/London

# Data Storage Paths (relative to backend root or absolute)
RAW_DATA_DIR=../data/raw
PROCESSED_DATA_DIR=../data/processed

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000
